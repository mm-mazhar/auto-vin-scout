// prisma/schema.prisma
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @unique // This will be the Supabase Auth user UUID
  name  String?
  email String  @unique

  colorScheme     String @default("theme-green")
  themePreference String @default("dark")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  invites     OrganizationInvite[]
}

model Subscription {
  stripeSubscriptionId  String        @id @unique
  interval              String
  status                String
  planId                String
  currentPeriodStart    Int
  currentPeriodEnd      Int
  periodEndReminderSent Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  organization          Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId        String?       @unique

  @@index([status])
  @@index([planId])
  @@index([createdAt(sort: Desc)])
  @@index([organizationId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Organization {
  id   String @id @default(cuid())
  name String @db.VarChar(20)
  slug String @unique

  // Billing (Moved from User)
  stripeCustomerId             String?  @unique
  isPrimary                    Boolean  @default(false)
  credits                      Int      @default(0)
  creditsReminderThresholdSent Boolean  @default(false)
  lastFreeRefillAt             DateTime @default(now())

  subscription Subscription?

  deletedAt DateTime? // Soft Delete

  members  OrganizationMember[]
  projects Project[]
  invites  OrganizationInvite[]
  reports  Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id             String @id @default(cuid())
  name           String @db.VarChar(20)
  slug           String
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model OrganizationInvite {
  id             String           @id @default(cuid())
  email          String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  status         InviteStatus     @default(PENDING)
  token          String           @unique
  expiresAt      DateTime

  inviterId String
  inviter   User   @relation(fields: [inviterId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([organizationId])
}

// --- AUTO VIN SCOUT SCHEMA ---

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
  FREE_PREVIEW
  ZERO_CREDITS
}

model Vehicle {
  id                   String  @id @default(cuid())
  vin                  String  @unique
  make                 String
  model                String
  year                 Int
  trim                 String?
  engine               String?
  driveType            String?
  vehicleType          String?
  manufacturer         String?
  plantCity            String?
  plantCountry         String?
  engineModel          String?
  engineCylinders      String?
  fuelInjectionType    String?
  fuelTypePrimary      String?
  fuelTypeSecondary    String?
  electrificationLevel String?

  // Premium fields from MarketCheck API
  bodySubtype    String?
  transmission   String?
  doors          Int?
  engineSize     Float?
  cylinders      Int?
  overallHeight  Float?
  overallLength  Float?
  overallWidth   Float?
  stdSeating     Int?
  highwayMpg     Float?
  cityMpg        Float?
  powertrainType String?

  // Decoder source tracking
  decoderSource String @default("NHTSA")

  reports        Report[]
  recalls        Recall[]
  listingHistory VehicleListingHistory[]
  safetyRating   VehicleSafetyRating?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vin])
  @@index([decoderSource])
}

model Report {
  id     String       @id @default(cuid())
  status ReportStatus @default(PENDING)

  organizationId String
  projectId      String
  vehicleId      String

  riskScore         Int?
  riskLabel         String?
  riskNarrative     String? @db.Text
  isAiFallback      Boolean @default(false)
  marketData        Json?
  environmentalData Json?

  executiveSummary  String? @db.Text
  negotiationScript String? @db.Text

  // Relations
  vehicle       Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vectorResults RiskVectorResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([vehicleId])
}

model Recall {
  id                 String   @id @default(cuid())
  vehicleId          String
  campaignNumber     String   @unique
  component          String
  summary            String   @db.Text
  consequence        String   @db.Text
  remedy             String   @db.Text
  notes              String?  @db.Text
  parkIt             Boolean  @default(false)
  parkOutSide        Boolean  @default(false)
  overTheAirUpdate   Boolean  @default(false)
  reportReceivedDate String?
  manufacturer       String?
  fetchedAt          DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([campaignNumber])
}

model VehicleListingHistory {
  id                String    @id @default(cuid())
  vehicleId         String
  externalListingId String // MarketCheck "id" field
  price             Float?
  miles             Int?
  msrp              Float?
  sellerType        String? // "dealer", "fsbo", "auction"
  inventoryType     String? // "new", "used"
  isCertified       Boolean?
  exteriorColor     String?
  interiorColor     String?
  dom               Int? // Days on market (lifetime)
  statusDate        DateTime?
  firstSeenAt       DateTime?
  lastSeenAt        DateTime?
  sellerName        String?
  city              String?
  state             String?
  zip               String?
  latitude          Float?
  longitude         Float?
  source            String? // Source website
  vdpUrl            String? // Vehicle Detail Page URL
  dataSource        String? // MarketCheck data_source field
  fetchedAt         DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, externalListingId])
  @@index([vehicleId])
  @@index([statusDate])
}

model RiskVectorResult {
  id          String   @id @default(cuid())
  reportId    String
  vectorIndex Int // 0, 1, 2, ... (ordering)
  vectorName  String // "Baseline Health & Market Anomalies"
  score       Int // 0-100
  label       String // "Low", "Medium", "High"
  weight      Float // 0.0-1.0 (e.g., 0.20)
  narrative   String   @db.Text
  metadata    Json? // Agent-specific structured data
  createdAt   DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([vectorIndex])
}

model VehicleSafetyRating {
  id        String @id @default(cuid())
  vehicleId String @unique

  // NHTSA identifiers
  nhtsaVehicleId     Int?
  vehicleDescription String?

  // Top-level ratings
  overallRating           String?
  overallFrontCrashRating String?
  overallSideCrashRating  String?
  rolloverRating          String?

  // Granular crash test fields
  frontCrashDriversideRating    String?
  frontCrashPassengersideRating String?
  sideCrashDriversideRating     String?
  sideCrashPassengersideRating  String?
  sidePoleCrashRating           String?
  rolloverPossibility           Float?
  dynamicTipResult              String?

  // ADAS fields
  nhtsaElectronicStabilityControl String?
  nhtsaForwardCollisionWarning    String?
  nhtsaLaneDepartureWarning       String?

  // Reputation fields
  complaintsCount    Int?
  investigationCount Int?

  // Media
  frontCrashPicture String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([nhtsaVehicleId])
}
