##########################################################################
### NEXT APP
##########################################################################
LOCAL_SITE_URL=http://localhost:3000
# Required in production
PRODUCTION_URL=https://your-production-domain.com
# Required in production
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NODE_ENV=development # production, development
# Multi‑Org Toggle (single vs multi‑organization mode)
# Set to 1 for single-organization mode, or any number greater than 1 for multi-organization mode
NEXT_PUBLIC_MAX_ORGANIZATIONS_PER_USER=
MAX_ORGANIZATIONS_PER_USER=

##########################################################################
### LLM
##########################################################################
OPENROUTER_API_KEY=...
GOOGLE_API_KEY=...

##########################################################################
### Google
##########################################################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

### Neo Tech PostgresSQL
# DATABASE_URL=""

##########################################################################
# Supabase
# Update these with your Supabase details from your project settings > API
##########################################################################
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
### Supabase | Connect to Supabase via connection pooling
DATABASE_URL=
# Direct connection to the database. Used for migrations
DIRECT_URL=

##########################################################################
# Stripe Configuration
##########################################################################
# https://your-domain.com/api/webhook/stripe
STRIPE_PRICE_ID_basic=
STRIPE_PRICE_ID_pro=
STRIPE_PRICE_ID_dealercore=
STRIPE_PRICE_ID_dealerplus=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# For Local
STRIPE_WEBHOOK_SECRET=
# For Production
# STRIPE_WEBHOOK_SECRET=

##########################################################################
### EMAIL CONFIGURATION (RESEND)
##########################################################################
# Get this from Resend:
# 1. Sign up at https://resend.com/
# 2. Go to API Keys section
# 3. Create a new API key
# 4. Add your domain for sending emails
APP_EMAIL=
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
SUPPORT_EMAIL=support@resend.dev
RESEND_TIMEOUT=30000

##########################################################################
### CRON SECRET
##########################################################################
CRON_SECRET=

##########################################################################
#### Add comma-separated emails of super admins
##########################################################################
SUPER_ADMIN_EMAILS=

##########################################################################
# Premium VIN Decoder (server-side only - never expose to client)
##########################################################################
PREMIUM_VIN_PROVIDER= # MARKETCHECK, vinaudit or carfax, edmunds, etc.
PREMIUM_VIN_API_KEY=
PREMIUM_VIN_API_SECRET=